<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+.
    Reference: https://developer.android.com/about/versions/12/backup-restore
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="download_history.db" />
        <exclude domain="database" path="download_history.db-shm" />
        <exclude domain="database" path="download_history.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="download_history.db" />
    </device-transfer>
</data-extraction-rules>
