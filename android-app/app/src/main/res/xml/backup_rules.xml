<?xml version="1.0" encoding="utf-8"?>
<!--
    Rules that control which files are backed up to the cloud (Android Auto Backup).
    Reference: https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Exclude Room database files (they'll be re-created from network) -->
    <exclude domain="database" path="download_history.db" />
    <exclude domain="database" path="download_history.db-shm" />
    <exclude domain="database" path="download_history.db-wal" />
</full-backup-content>
