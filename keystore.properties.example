# Template for release APK signing (Optional)
# Copy this file to keystore.properties and fill with your release keystore credentials.
# If this file is absent, Gradle automatically falls back to default debug signing
# so contributors can build without errors.

storeFile=/path/to/your/release-key.jks
storePassword=your_keystore_password
keyAlias=your_key_alias
keyPassword=your_key_password
